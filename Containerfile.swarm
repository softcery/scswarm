FROM fedora:44

RUN dnf -y install git make python3 nodejs npm rust cargo rustfmt clippy \
    gcc pkgconf-pkg-config openssl-devel ripgrep \
 && dnf clean all

# Pinned: the build cache keeps an unpinned install at its first version.
ARG CLAUDE_CODE_VERSION=2.1.280
RUN npm install -g @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION} && npm cache clean --force

RUN useradd --uid 1001 --create-home dev
USER dev

# Project name and `workers` of the host file. The worker passes no build argument.
ARG PROJECT=scswarm
ARG WORKERS=2

# Agent runs unattended: no trust prompt, no onboarding prompt. Trusted paths are
# the bare repo and every slot worktree the swarm mounts.
RUN set -eu; \
    trust() { printf '"%s":{"hasTrustDialogAccepted":true}' "$1"; }; \
    projects=$(trust "/home/dev/swarm/${PROJECT}.git"); \
    slot=0; \
    while [ "$slot" -lt "$WORKERS" ]; do \
      projects="$projects,$(trust "/home/dev/swarm/slot/${slot}/tree")"; \
      slot=$((slot + 1)); \
    done; \
    printf '{"hasCompletedOnboarding":true,"bypassPermissionsModeAccepted":true,"projects":{%s}}' \
      "$projects" > /home/dev/.claude.json

# Host writes every commit, so the agent must add no trailer of its own.
RUN mkdir -p /home/dev/.claude \
 && printf '%s' '{"attribution":{"commit":"","pr":"","sessionUrl":true}}' \
      > /home/dev/.claude/settings.json

ENV CARGO_BUILD_JOBS=4
