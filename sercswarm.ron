(
  workers: 2,
  image: "Containerfile.swarm",
  mounts: [],
  env: ["CLAUDE_CODE_OAUTH_TOKEN"],
  default_agent: "claude",
  agents: {
    "claude": (
      exec: "claude --dangerously-skip-permissions -p --output-format json",
      resume: "--resume {session}",
    ),
  },
  stages: [
    (turns: ["/execute {task}", "Correct, clean, beautiful?", "Mark the impl into the task file.", "{commit}"]),
    (turns: ["/audit {task}", "Audited thoroughly, checked everything, no gaps? If any, close them.", "What is the plan to resolve all audit issues and make the implementation correct, clean, beautiful?", "Write the audit and the plan into that same original task file.", "{commit}"]),
    (turns: ["/execute {task}", "Correct, clean, beautiful?", "Mark the impl into the task file.", "{commit}"]),
  ],
)
